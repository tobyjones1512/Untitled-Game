# Room state store (REQUIRED on Vercel). Create a free Upstash Redis database
# (Vercel Marketplace > Upstash Redis) and Vercel will inject these for you.
# Without them the app falls back to in-memory state, which only works for
# local `next dev` because serverless instances do not share memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional TURN server for players behind strict NATs (WebRTC relay).
# STUN-only works for most home networks.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
