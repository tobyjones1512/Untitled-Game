# Room state store (REQUIRED on Vercel). Create a FREE Upstash Redis database at
# console.upstash.com (no card needed) and paste its REST URL + token here / in Vercel.
# Without them the app falls back to in-memory state, which only works for
# local `next dev` because serverless instances do not share memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stranger matchmaking turns on when this is set (Stripe Identity age check). Leave empty to keep it off.
STRIPE_SECRET_KEY=

# Optional TURN server for players behind strict NATs (WebRTC relay).
# STUN-only works for most home networks.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
